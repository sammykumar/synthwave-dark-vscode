// SynthWave token palette; workbench UI colors follow VS Code's 2026 Dark theme.
/* Pink: #F92672
   Blue: #66D9EF
   Green: #4ade80
   Yellow: #E6DB74
   Orange: #FD971F
   Purple: #AE81FF
   Red: #FF5555
   White: #F8F8F2
   Black: #0A0A0A
   Gray: #181A1F
   Apple Intelligence Placeholder: #fc0303
*/
{
  "name": "SynthWave 84",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
